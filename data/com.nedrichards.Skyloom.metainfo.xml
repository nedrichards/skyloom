<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>com.nedrichards.Skyloom</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>GPL-3.0-or-later</project_license>
  <name>Skyloom</name>
  <summary>Read and join conversations on Bluesky</summary>
  <description><p>A native GNOME client for Bluesky with a calm reading and writing experience. Sign in with a dedicated app password, or explore the offline demo without an account.</p><p>Skyloom is independent and is not affiliated with Bluesky.</p></description>
  <url type="homepage">https://github.com/nedrichards/skyloom</url>
  <url type="bugtracker">https://github.com/nedrichards/skyloom/issues</url>
  <url type="vcs-browser">https://github.com/nedrichards/skyloom</url>
  <launchable type="desktop-id">com.nedrichards.Skyloom.desktop</launchable>
  <developer id="com.nedrichards"><name>Nick Richards</name></developer>
  <content_rating type="oars-1.1"><content_attribute id="social-chat">intense</content_attribute><content_attribute id="social-info">mild</content_attribute></content_rating>
  <supports><control>pointing</control><control>keyboard</control><control>touch</control></supports>
  <requires><display_length compare="ge">380</display_length></requires>
  <screenshots>
    <screenshot type="default">
      <caption>Skyloom's Bluesky feed in light mode</caption>
      <image>https://raw.githubusercontent.com/nedrichards/skyloom/main/screenshots/showcase/home-1280-light.png</image>
    </screenshot>
    <screenshot>
      <caption>Skyloom's Bluesky feed in dark mode</caption>
      <image>https://raw.githubusercontent.com/nedrichards/skyloom/main/screenshots/showcase/home-480-dark.png</image>
    </screenshot>
  </screenshots>
  <releases>
    <release version="0.1.1" date="2026-11-13">
      <url>https://github.com/nedrichards/skyloom/releases/tag/v0.1.1</url>
      <description>
        <p>Manage your posts with deletion, private bookmarks and reply and quote controls. Edit your profile and browse followers and following.</p>
        <p>Play videos with native controls and upload described MP4 clips. Includes atproto SDK 0.0.74 and improved cache and session safeguards.</p>
      </description>
    </release>
    <release version="0.1.0" date="2026-10-26"><description><p>Initial release.</p></description></release>
  </releases>
</component>
