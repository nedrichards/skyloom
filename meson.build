project('skyloom', version: '0.1.0', meson_version: '>=1.0.0')
gnome = import('gnome')
python = import('python').find_installation('python3')
assert(python.language_version().version_compare('>=3.14'), 'Skyloom requires Python 3.14 or newer')
app_id = 'com.nedrichards.Skyloom'
subdir('data')
configuration = configuration_data()
configuration.set('PYTHON', python.full_path())
configuration.set('PKGDIR', get_option('prefix') / 'share' / 'skyloom')
configure_file(input: 'data/skyloom.in', output: 'skyloom', configuration: configuration, install: true, install_dir: get_option('bindir'), install_mode: 'rwxr-xr-x')
install_subdir('src/skyloom', install_dir: get_option('datadir') / 'skyloom', exclude_directories: ['__pycache__'])
install_subdir('fixtures', install_dir: get_option('datadir') / 'skyloom')
install_data('data' / app_id + '.desktop', install_dir: get_option('datadir') / 'applications')
install_data('data' / app_id + '.metainfo.xml', install_dir: get_option('datadir') / 'metainfo')
install_data('data' / app_id + '.gschema.xml', install_dir: get_option('datadir') / 'glib-2.0/schemas')
install_data('data/icons' / app_id + '.svg', install_dir: get_option('datadir') / 'icons/hicolor/scalable/apps')
install_data('data/icons' / app_id + '-symbolic.svg', install_dir: get_option('datadir') / 'icons/hicolor/symbolic/apps')
gnome.compile_resources('skyloom', 'data/skyloom.gresource.xml', source_dir: 'data', gresource_bundle: true, install: true, install_dir: get_option('datadir') / 'skyloom')
gnome.post_install(glib_compile_schemas: true, gtk_update_icon_cache: true, update_desktop_database: true)
test('runtime', python, args: [meson.project_source_root() / 'scripts/runtime-tests.py', '--tests', meson.project_source_root() / 'tests'], timeout: 300, env: ['PYTHONPATH=' + meson.project_source_root() / 'src', 'GSETTINGS_SCHEMA_DIR=' + meson.project_build_root() / 'data'])
